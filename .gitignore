# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# broken dependency backup
node_modules_broken_backup/

# local work / verification temp (headless-chrome profiles, probe scripts, bundle dumps)
.wb-tmp/
.workbuddy/

# build & debug logs
build*.log
*.bak

# icon preview artifacts
icon_preview*.png
